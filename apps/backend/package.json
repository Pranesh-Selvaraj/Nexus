{
  "name": "@nexus/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "concurrently -n api,worker -c cyan,magenta \"tsx watch src/index.ts\" \"tsx watch src/workers/embedding.worker.ts\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/workers/embedding.worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "start:worker": "tsx src/workers/embedding.worker.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@nexus/shared-types": "workspace:*",
    "@trpc/server": "^10.45.2",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.1",
    "ioredis": "^5.4.1",
    "langchain": "^0.2.19",
    "multer": "^2.0.1",
    "openai": "^4.67.3",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}