# --- Postgres (pgvector/pgvector:pg16 via docker compose) ---
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus

# --- Redis (redis:7-alpine via docker compose) ---
REDIS_URL=redis://localhost:6379

# --- OpenAI-compatible providers ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TEMPERATURE=0.2
# OpenAI-compatible base URL for chat — any custom endpoint (OpenCode
# Zen / Go plan, Ollama, OpenRouter, Groq, LM Studio, ...).
# Leave empty for api.openai.com.
# OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
# Separate embedding provider (needed for chat-only providers like
# OpenCode Zen, which has no embeddings endpoint). Falls back to the
# main base URL / key when unset.
# OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_API_KEY=sk-your-embedding-provider-key

# --- Voice (speech-to-text / text-to-speech) ---
# Server transcription and speech-synthesis models. Dedicated base URLs/keys
# fall back to the main provider above when unset.
# OPENAI_STT_MODEL=whisper-1
# OPENAI_STT_BASE_URL=https://api.openai.com/v1
# OPENAI_STT_API_KEY=sk-your-transcription-key
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy
# OPENAI_TTS_BASE_URL=https://api.openai.com/v1
# OPENAI_TTS_API_KEY=sk-your-speech-key
# Default dictation language (BCP-47, or 'auto' to let the provider detect it).
# STT_LANGUAGE=auto
# Optional local faster-whisper (OpenAI-compatible) fallback used when the
# primary transcription provider fails - keeps audio on-premises.
# WHISPER_LOCAL_URL=http://localhost:8000/v1
# Model id served by the local sidecar (defaults to OPENAI_STT_MODEL).
# WHISPER_LOCAL_MODEL=large-v3
# Audio cache retention (days; 0 keeps until the storage cap evicts) and cap.
# AUDIO_RETENTION_DAYS=7
# AUDIO_MAX_STORAGE_MB=200
# Per-recording upload cap for dictation/pronunciation (MB).
# MAX_AUDIO_MB=25

# --- Retrieval ---
# Full-text search language (PostgreSQL text search config).
# RETRIEVAL_LANGUAGE=english

# --- UI ---
# PROMPT_SYSTEM=You are Nexus, a precise retrieval-augmented assistant.

# --- Identity (single user) ---
# LOCAL_USER_EMAIL=local@nexus.dev

# --- Authentication (optional) ---
# Set AUTH_PASSWORD to require login. When unset, the app runs in
# single-user no-auth mode (dev only - see SECURITY.md).
# AUTH_PASSWORD=change-me
# AUTH_COOKIE_SECURE=true    # set when serving over HTTPS
# SESSION_TTL_DAYS=30

# --- UI-managed settings ---
# Encryption key for secret settings (e.g. the OpenAI API key) saved from
# the settings panel. Non-secret settings work without it.
# SETTINGS_SECRET=generate-a-long-random-string

# --- Server ---
PORT=3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
# Hard cap for workspace archive imports (multipart JSON file upload).
MAX_IMPORT_MB=100
FRONTEND_ORIGIN=http://localhost:5173