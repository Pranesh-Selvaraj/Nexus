{
  "name": "nexus",
  "version": "0.3.0",
  "private": true,
  "description": "Nexus - full-stack AI RAG workspace with hybrid search and queue-based indexing",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "turbo": "^2.3.3",
    "typescript-eslint": "^8.67.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
